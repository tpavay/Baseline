# macOS
.DS_Store
*.swp

# Xcode
# Project is generated by XcodeGen from project.yml — not committed.
*.xcodeproj
*.xcworkspace
# Info.plist is generated by XcodeGen (info: block in project.yml) — not committed.
Baseline/Info.plist
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# CocoaPods / Carthage (if ever used)
Pods/
Carthage/Build/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Secrets / config — NEVER commit
*.xcconfig.local
GoogleService-Info*.plist
.env
.env.*
secrets/
*.p8
*.p12
*.mobileprovision
*.cer

# Node (Cloud Functions)
functions/node_modules/
node_modules/
functions/.secret.local

# Misc
*.log
